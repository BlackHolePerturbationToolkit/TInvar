Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<xAct`TInvar`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$DefInfoQ", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "4", ",", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"IndexRange", "[", 
       RowBox[{"a", ",", "z"}], "]"}], ",", 
      RowBox[{"{", "g", "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", " ", "CD"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "RiemannCD", "]"}], "^=", "\"\<R\>\""}], 
  ";"}], "\[LineSeparator]", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "RicciCD", "]"}], "^=", "\"\<R\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "[", "RicciScalarCD", "]"}], "^=", "\"\<R\>\""}], 
  ";"}]}], "ExampleInitialization",
 CellChangeTimes->{{3.9433589222308493`*^9, 3.943358946977306*^9}, {
  3.9433594162721157`*^9, 3.943359417103158*^9}},

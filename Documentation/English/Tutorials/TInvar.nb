Cell[CellGroupData[{

Cell[TextData[{
 "Next we define some basic xAct structures: a manifold ",
 Cell[BoxData["M"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "2b5d6eaa-0da8-47ac-8968-02c596e0c51a"],
 ", a metric ",
 Cell[BoxData[
  SubscriptBox["g", "ab"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "3bd157e8-5725-4efe-8d06-3e335180d3ae"],
 " and an associated covariant derivative ",
 Cell[BoxData["CD"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "a6ece088-1b39-44c4-88f7-3ebbecae793f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9433519445675793`*^9, 3.9433519904092216`*^9}, {
  3.943353440970421*^9, 3.943353441566658*^9}},
 CellID->600568387,ExpressionUUID->"73326054-431c-42d0-bc24-2a7493c10c32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$DefInfoQ", "=", "False"}], ";"}]], "Input",
 CellChangeTimes->{{3.932612682870026*^9, 3.9326127215126762`*^9}, {
  3.943352053845806*^9, 3.943352059480453*^9}},
 CellLabel->"In[2]:=",
 CellID->2009204512,ExpressionUUID->"dfd381fa-7521-4e52-887b-4147678d6ed3"],

Cell[BoxData[
 RowBox[{"DefManifold", "[", 
  RowBox[{"M", ",", "4", ",", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"IndexRange", "[", 
      RowBox[{"a", ",", "z"}], "]"}], ",", 
     RowBox[{"{", "g", "}"}]}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.932612682870026*^9, 3.9326127215126762`*^9}},
 CellLabel->"In[3]:=",
 CellID->1020532383,ExpressionUUID->"cb89584e-c26e-4c1d-9b54-fa72aab4bf6e"],

Cell[BoxData[
 RowBox[{"DefMetric", "[", 
  RowBox[{
   RowBox[{"-", "1"}], ",", 
   RowBox[{"g", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}]}], "]"}], ",", " ", "CD"}], "]"}]], "Input",
 CellChangeTimes->{{3.932612699789695*^9, 3.932612751334121*^9}},
 CellLabel->"In[4]:=",
 CellID->478967309,ExpressionUUID->"58331ae4-bf38-4d5d-8064-85478c04fffa"],


Cell[CellGroupData[{

Cell["MathTensor identities", "Subsection",
 CellChangeTimes->{{3.943357286233037*^9, 3.943357289813669*^9}},
 CellID->1765418585,ExpressionUUID->"e6814655-1208-4b1f-a5ce-adeda7630e4d"],

Cell[CellGroupData[{

Cell["\<\
The MathTensor package by Leonard Parker and Steven M. Christensen includes a \
database of several commonly used identities. Let's use RiemannSimplify to \
check them. First, we define the 40 identities:\
\>", "Text",
 CellChangeTimes->{{3.9433553476593733`*^9, 3.943355352347261*^9}, {
  3.94335539544039*^9, 3.943355429104952*^9}, {3.9433573177638187`*^9, 
  3.943357328197114*^9}},
 CellID->991241656,ExpressionUUID->"2d65978a-4c3e-4515-ba29-4a100d7eff45"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"R1a", "=", 
   RowBox[{"RiemannCD", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", "a", ",", 
     RowBox[{"-", "c"}], ",", 
     RowBox[{"-", "d"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R1b", "=", 
   RowBox[{"RiemannCD", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}], ",", 
     RowBox[{"-", "c"}], ",", "c"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R2", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", "a", ",", 
      RowBox[{"-", "d"}]}], "]"}], "-", 
    RowBox[{"RicciCD", "[", 
     RowBox[{
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "d"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R3", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", "a"}], "]"}], "+", 
    RowBox[{"RicciCD", "[", 
     RowBox[{
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R4", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", "b", ",", 
      RowBox[{"-", "d"}]}], "]"}], "+", 
    RowBox[{"RicciCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "d"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R5", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", "b"}], "]"}], "-", 
    RowBox[{"RicciCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "c"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R6a", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", 
      RowBox[{"-", "d"}]}], "]"}], 
    RowBox[{"RicciCD", "[", 
     RowBox[{"a", ",", "b"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R6b", "=", 
   RowBox[{
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", 
      RowBox[{"-", "d"}]}], "]"}], 
    RowBox[{"RicciCD", "[", 
     RowBox[{"c", ",", "d"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R7", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "e"}], ",", "a", ",", "b", ",", "c"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "p"}], ",", 
       RowBox[{"-", "d"}], ",", 
       RowBox[{"-", "q"}], ",", 
       RowBox[{"-", "r"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "e"}], ",", "p", ",", "q", ",", "r"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"R8", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "h"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "p"}], ",", 
       RowBox[{"-", "d"}], ",", 
       RowBox[{"-", "q"}], ",", 
       RowBox[{"-", "r"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"p", ",", "h", ",", "q", ",", "r"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R9a", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "e"}], ",", "a", ",", 
       RowBox[{"-", "i"}], ",", "b"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "p"}], ",", 
       RowBox[{"-", "q"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "e"}], ",", 
       RowBox[{"-", "i"}], ",", "p", ",", "q"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R9b", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RiemannCD", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}], ",", 
       RowBox[{"-", "c"}], ",", 
       RowBox[{"-", "d"}]}], "]"}], 
     RowBox[{"RiemannCD", "[", 
      RowBox[{"e", ",", "a", ",", "b", ",", "h"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 

Cell[CellGroupData[{

Cell["\<\
These expressions should all be equal to zero, but to show that in many cases \
the Bianchi identities are required. Let's now print out a table of all \
invariants and indicate whether they are identified as being equal to zero by \
ToCanonical and by RiemannSimplify:\
\>", "Text",
 CellChangeTimes->{{3.9433556142497*^9, 3.943355615957814*^9}, {
   3.9433564434444437`*^9, 3.9433564454493723`*^9}, {3.943356557846139*^9, 
   3.943356613458304*^9}, 3.9433573426864*^9, {3.943357712149312*^9, 
   3.943357712731439*^9}},
 CellID->938267510,ExpressionUUID->"b57d3d60-beb4-4a86-846c-41fe836b82d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Expression\>\"", ",", "\"\<ToCanonical\>\"", ",", 
        "\"\<RiemannSimplify\>\""}], "}"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rie", ",", 
         RowBox[{"SameQ", "[", 
          RowBox[{
           RowBox[{"ToCanonical", "[", "rie", "]"}], ",", "0"}], "]"}], ",", 
         RowBox[{
          RowBox[{"RiemannSimplify", "[", "rie", "]"}], "==", "0"}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"rie", ",", 
         RowBox[{"{", 
          RowBox[{
          "R1a", ",", "R1b", ",", "R2", ",", "R3", ",", "R4", ",", "R5", ",", 
           "R6a", ",", "R6b", ",", "R7", ",", "R8", ",", "R9a", ",", "R9b", 
           ",", "R9c", ",", "R9d", ",", "R10", ",", "R11", ",", "R12", ",", 
           "R13", ",", "R14", ",", "R15", ",", "R16", ",", "R17", ",", "R18", 
           ",", "R19", ",", "R20", ",", "R21", ",", "R22", ",", "R23", ",", 
           "R24", ",", "R25", ",", "R26", ",", "R27", ",", "R28", ",", "R29", 
           ",", "R30", ",", "R31a", ",", "R31b", ",", "R32a", ",", "R32b", 
           ",", "R33a", ",", "R33b", ",", "R34", ",", "R35", ",", "R36", ",", 
           "R37", ",", "R38", ",", "R39", ",", "R40"}], "}"}]}], "}"}]}], 
      "]"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",

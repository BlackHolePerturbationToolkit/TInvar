Cell[TextData[{
 "Internally,  TInvar converts all expressions to an \"invariant\" format. We \
do not usually need to know about this when running ",
 ButtonBox["RiemannSimplify",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/RiemannSimplify"],
 ", but if we wise we can convert explicitly to and from this format using ",
 ButtonBox["RiemannToInv",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/RiemannToInv"],
 " and ",
 ButtonBox["InvToRiemann",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/InvToRiemann"],
 ":"
}], "Text",
 CellChangeTimes->{{3.943353635488681*^9, 3.943353732356885*^9}},
 CellID->331583591,ExpressionUUID->"130811dc-fc3d-406e-bca6-2ef4ab2eea93"],


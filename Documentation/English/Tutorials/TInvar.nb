Cell[CellGroupData[{

Cell["Decanini & Folacci identities", "Subsection",
 CellChangeTimes->{{3.943356758186108*^9, 3.943356763010611*^9}},
 CellID->1250714064,ExpressionUUID->"c9b6c573-5ba3-42bc-b7b0-c196bab3122f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Another large set of useful identities were also derived in \"",
 ButtonBox["FKWC-bases and geometrical identities for classical and quantum \
field theories in curved spacetime",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.48550/arXiv.0805.1595"], None}],
 "\", Y. Decanini and A. Folacci. Let's also check those. First we define the \
expressions by their equation number in the paper:"
}], "Text",
 CellChangeTimes->{{3.9433567683764753`*^9, 3.943356825738982*^9}, {
   3.943357393684162*^9, 3.9433573980941067`*^9}, 3.9433574378794928`*^9, {
   3.943359557986308*^9, 3.9433595602892733`*^9}},
 CellID->675771218,ExpressionUUID->"cc667e9f-0b20-4509-a568-7b227c6d4caf"],


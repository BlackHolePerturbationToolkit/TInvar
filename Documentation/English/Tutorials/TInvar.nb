     ButtonData->"paclet:TInvar/ref/RiemannToInv"], Cell[
    "convert Riemann tensors to invariants", "TableText",ExpressionUUID->
     "32f39404-91a0-4e8c-9b2c-004e188ce531"]},
   {
    ButtonBox["InvToRiemann",
     BaseStyle->"Link",

Cell[TextData[{
 "The notation ",
 Cell[BoxData[
  SubscriptBox[
   SuperscriptBox["I", "n"], 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["i", "1"], 
       SubscriptBox["i", "2"]}], "..."}], 
     SubscriptBox["i", "m"]}], ",", "j"}]]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "b81f3da0-1f92-4273-9346-a61b373b6cec"],
 " here represents the ",
 Cell[BoxData["j"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "089e3cc0-0edf-4e47-b157-a8c07b642356"],
 "-th invariant in the part of the basis with ",
 Cell[BoxData["n"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "d9433062-ad63-4403-af04-29474b92f3fc"],
 " free indices, ",
 Cell[BoxData["m"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "f01a8fe4-0b6a-4e5e-a7b3-3622a31e5ea4"],
 " Riemann tensors, and ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["i", "1"], ",", "...", ",", 
   SubscriptBox["i", "m"]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "27e353a5-1ac3-4059-bb99-b8039bca67c7"],
 " covariant derivatives acting on those Riemann tensors."
}], "Text",
 CellChangeTimes->{{3.943353876255031*^9, 3.943354057061275*^9}, {
  3.943354439045648*^9, 3.94335449185102*^9}},
 CellID->1054882638,ExpressionUUID->"a04505c3-66c7-4e83-93c9-d49ae720b665"],


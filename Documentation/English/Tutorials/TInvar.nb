 CellID->891454128,ExpressionUUID->"d07ae9ea-1f92-49f5-898c-16df827d0e6f"],

Cell["High-level functions.", "Caption",
 CellChangeTimes->{{3.932612085935902*^9, 3.932612088853965*^9}},
 CellID->1823607824,ExpressionUUID->"66611f97-9b63-47b4-a813-9b9e1bd3ab4d"],

Cell[TextData[{
 "At the highest level is ",
 ButtonBox["RiemannSimplify",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/RiemannSimplify"],
 ". This takes as input a tensor expression involving the Riemann tensor and \
writes it in canonical form in terms of the Fulling et al. basis."
}], "Text",
 CellChangeTimes->{{3.943352170415146*^9, 3.9433521815076714`*^9}, {
  3.943352231525737*^9, 3.94335228049218*^9}, {3.9433535109419117`*^9, 
  3.943353528391523*^9}},
 CellID->270715223,ExpressionUUID->"4012fd14-92e5-463d-b24e-80c179c3b835"],

Cell[CellGroupData[{

Cell["Examples using RiemannSimplify:", "MathCaption",
 CellChangeTimes->{{3.932611849230828*^9, 3.9326118544015102`*^9}},
 CellID->490087984,ExpressionUUID->"c3d882cb-1f6a-4218-8ef2-1bed7ec61b0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"expr", "=", 
  RowBox[{
   RowBox[{"RiemannCD", "[", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "+", 
   RowBox[{"RiemannCD", "[", 
    RowBox[{"a", ",", "c", ",", "d", ",", "b"}], "]"}], "+", 
   RowBox[{"RiemannCD", "[", 
    RowBox[{"a", ",", "d", ",", "b", ",", "c"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.943353537032333*^9, 3.943353537792857*^9}},
 CellLabel->"In[8]:=",
 CellID->389713711,ExpressionUUID->"de9f627f-2827-4d2c-8fba-f6e16a0e0ff0"],

Cell[BoxData[
 RowBox[{
  InterpretationBox[
   StyleBox[GridBox[{
      {"R", 
       StyleBox[GridBox[{
          {"a", "b", "c", "d"},
          {" ", " ", " ", " "}
         },
         GridBoxSpacings->{"Columns" -> {

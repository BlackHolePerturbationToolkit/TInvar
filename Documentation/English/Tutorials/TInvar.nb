Cell[TextData[{
 "Note that ",
 Cell[BoxData["j"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "e801a23c-83cb-4840-972f-53741742297e"],
 " counts not only independent elements of the basis, but a larger set of ",
 StyleBox["canonical permutations",
  FontSlant->"Italic"],
 ". These permutations are a step between tensor expressions and invariants. \
The set of all permutations represent all possibilities that can be produced \
by ToCanonical for a given order, degree and rank. Not all of these \
permutations are independent, but they can all be projected to the canonical \
basis of independent invariants. The functions ",
 ButtonBox["RiemannToPerm",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/RiemannToPerm"],
 ", ",
 ButtonBox["PermToRiemann",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/PermToRiemann"],
 ", ",
 ButtonBox["InvToPerm",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/InvToPerm"],
 " and ",
 ButtonBox["PermToInv",
  BaseStyle->"Link",
  ButtonData->"paclet:TInvar/ref/PermToInv"],
 " allow transforming between these different representations: "
}], "Text",
 CellChangeTimes->{{3.943354399569182*^9, 3.943354413449153*^9}, {
  3.9433544985706253`*^9, 3.943354627593904*^9}, {3.9433550177130203`*^9, 
  3.9433551577220592`*^9}},
 CellID->528922879,ExpressionUUID->"0ff242b8-3bdb-43f7-bc64-393173111df6"],

